# Reproduce translation
Run these commands from WSL Ubuntu:
cd ~/project

MODEL=~/m1-data/model/model/moses.ini
MOSES=~/mosesdecoder/bin/moses
TOKENIZER=~/mosesdecoder/scripts/tokenizer/tokenizer.perl
DETOKENIZER=~/mosesdecoder/scripts/tokenizer/detokenizer.perl

#Test one sentence:
printf "He is a scientist.\n" |
perl "$TOKENIZER" -l en |
"$MOSES" -f "$MODEL" |
perl "$DETOKENIZER" -l kn

#Translate FLORES dev:
perl "$TOKENIZER" -l en \
  < data/raw/flores200_dataset/dev/eng_Latn.dev 2>/dev/null |
"$MOSES" -f "$MODEL" \
  2> results/m1/flores-dev.decode.log |
perl "$DETOKENIZER" -l kn 2>/dev/null \
  > results/m1/flores-dev.pred.kn

#Verify counts:
wc -l \
  data/raw/flores200_dataset/dev/kan_Knda.dev \
  results/m1/flores-dev.pred.kn \
  data/raw/flores200_dataset/devtest/kan_Knda.devtest \
  results/m1/flores-devtest.pred.kn \
  data/raw/in22/in22gen.kan_Knda \
  results/m1/in22gen.pred.kn

#Calculate metrics:
~/.local/bin/sacrebleu \
  data/raw/flores200_dataset/dev/kan_Knda.dev \
  -i results/m1/flores-dev.pred.kn \
  -m bleu chrf --tokenize none

~/.local/bin/sacrebleu \
  data/raw/flores200_dataset/dev/kan_Knda.dev \
  -i results/m1/flores-dev.pred.kn \
  -m bleu --tokenize spBLEU-1K

